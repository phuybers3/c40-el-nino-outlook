e, this does not necessarily mean the air is drier. For Mar–May 2027, a warmer-than-normal season is more likely than not (about 60%), about 0.9 °C above the 1991–2020 average, mostly because of the long-term warming trend rather than El Niño. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":5.1244,"trend_per_decade":0.4423,"trend_p":0.0,"trend_total_since_1951":3.3172,"enso_effect_per_degC":-0.0229,"enso_p":0.8774,"confidence":"No identifiable effect","survives_fdr":false,"fraction_explained":0.0003,"intrinsic_sd":1.1778,"effect_this_season":-0.0294,"effect_ratio":0.025,"size":"Negligible","size_typical_el_nino":"Negligible","once_every_n_years_without_el_nino":null,"expected_anomaly_2027":0.8581,"forecast_mean":5.9825,"forecast_sd":1.2442,"p_below":0.1494,"p_near":0.2662,"p_above":0.5844,"forecast_words":"More likely than not (58%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":-0.0116,"shrink_factor":0.5069,"effect_this_season_raw":-0.058,"trend_part_2027":0.8875,"roni_upper_within_record":false,"years_of_warming_equivalent":-0.6646,"percentiles":{"p05":{"trend_per_decade":0.5857,"trend_p":0.0005,"enso_effect_per_degC":0.0952,"enso_p":0.8323,"confidence":"No identifiable effect","shift_this_season":0.241,"lines_cross":false},"p50":{"trend_per_decade":0.4655,"trend_p":0.0,"enso_effect_per_degC":-0.1484,"enso_p":0.2775,"confidence":"No identifiable effect","shift_this_season":-0.3754,"lines_cross":false},"p95":{"trend_per_decade":0.3951,"trend_p":0.0016,"enso_effect_per_degC":0.0961,"enso_p":0.7572,"confidence":"No identifiable effect","shift_this_season":0.2432,"lines_cross":false},"tails":{"enso_difference":0.0009,"enso_difference_p":0.99