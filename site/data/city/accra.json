00,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025],"roni_lead":[-0.38,0.98,0.04,0.84,-0.31,-1.31,-0.14,1.16,0.24,0.04,0.08,-0.16,-0.3,1.06,-0.64,1.86,-0.03,-0.08,0.56,0.67,-0.57,-0.4,1.82,-1.63,-0.45,-0.95,1.04,0.89,-0.08,0.52,-0.06,-0.17,2.03,-0.9,-0.61,-0.18,1.0,1.2,-1.71,-0.23,0.27,1.2,0.1,0.46,0.97,-0.93,-0.25,2.22,-1.33,-1.06,-0.55,-0.18,1.18,0.17,0.7,-0.18,0.73,-1.33,-0.38,0.86,-1.61,-0.91,0.21,-0.22,0.35,2.03,-0.96,-0.82,0.62,0.15,-1.37,-1.08,-1.1,1.3,-0.76],"paragraph":"Mar–May in Accra has warmed by about 0.3 °C per decade since 1951, roughly 2.2 °C in all, and the hottest days have warmed faster than the coldest (about 0.3 vs 0.2 °C per decade). There is a strong, well-established El Niño effect on temperature: after El Niño conditions in the preceding fall, Mar–May tends to run warmer, and El Niño accounts for about 40% of the year-to-year ups and downs. With this year's strong El Niño, that push is about 2 times a normal year-to-year swing, roughly as much warmth as 20 years of the long-term trend. Without El Niño, a Mar–May this warm would come about once every 64 years. El Niño moves the hottest days most: this season they are expected to shift by about 0.7 °C, against 0.4 °C for the coldest days. Mar–May rainfall has fallen by about 5% per decade. El Niño has a clear effect toward a drier season with less intense heavy-rain days, and this year's shift is substantial. Relative humidity has fallen by about 0.5 points per decade, roughly 4 points since 1951; because warmer air holds more moisture, this does not necessarily mean the air is drier. El Niño has a clear effect toward a less humid Mar–May, and this year's shift is substantial. For Mar–May 2027, a warmer-than-normal season is very likely (more than 95% chance), about 1.2 °C above the 1991–2020 average, mostly because of the long-term warming trend rather than El Niño; a drier-than-normal season is likely (about 80% chance), and a less humid season than normal is likely (about 70% chance). The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":28.0805,"trend_per_decade":0.2887,"trend_p":0.0,"trend_total_since_1951":2.1653,"enso_effect_per_degC":0.2417,"enso_p":0.0,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.4124,"intrinsic_sd":0.2704,"effect_this_season":0.5816,"effect_ratio":2.1511,"size":"Dominant","size_typical_el_nino":"Dominant","once_every_n_years_without_el_nino":64,"expected_anomaly_2027":1.219,"forecast_mean":29.2995,"forecast_sd":0.2978,"p_below":0.0,"p_near":0.0003,"p_above":0.9997,"forecast_words":"Very likely (>95%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":0.2299,"shrink_factor":0.9512,"effect_this_season_raw":0.6114,"trend_part_2027":0.6374,"roni_upper_within_record":false,"years_of_warming_equivalent":20.1457,"percentiles":{"p05":{"trend_per_decade":0.2072,"trend_p":0.0,"enso_effect_per_degC":0.1543,"enso_p":0.003,"confidence":"Strong","shift_this_season":0.3903,"lines_cross":false},"p50":{"trend_per_decade":0.3093,"trend_p":0.0,"enso_effect_per_degC":0.2522,"enso_p":0.0,"confidence":"Strong","shift_this_season":0.638,"lines_cross":false},"p95":{"trend_per_decade":0.2915,"trend_p":0.0,"enso_effect_per_degC":0.2792,"enso_p":0.0,"confidence":"Strong","shift_this_season":0.7065,"lines_cross":false},"tails":{"enso_difference":0.125,"enso_difference_p":0.0063,"trend_difference":0.0843,"trend_difference_p":0.0}},"values":[26.477,27.212,26.586,26.678,26.345,26.347,26.258,26.842,27.301,26.888,27.197,26.922,27.008,27.284,26.96,27.24,26.969,26.97,27.368,27.328,27.205,26.943,27.848,26.753,26.783,26.511,27.478,26.722,27.144,27.05,2