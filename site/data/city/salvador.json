armer-than-normal season is very likely (more than 95% chance), about 0.7 °C above the 1991–2020 average. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":26.1393,"trend_per_decade":0.1553,"trend_p":0.0,"trend_total_since_1951":1.165,"enso_effect_per_degC":0.1663,"enso_p":0.0,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.2123,"intrinsic_sd":0.3002,"effect_this_season":0.4208,"effect_ratio":1.4016,"size":"Dominant","size_typical_el_nino":"Substantial","once_every_n_years_without_el_nino":12,"expected_anomaly_2027":0.7268,"forecast_mean":26.866,"forecast_sd":0.3278,"p_below":0.0035,"p_near":0.0196,"p_above":0.9769,"forecast_words":"Very likely (>95%): a warmer-than-normal season","within_record":false,"trend_part_2027":0.306,"roni_upper_within_record":false,"years_of_warming_equivalent":27.0887,"percentiles":{"p05":{"trend_per_decade":0.1658,"trend_p":0.0,"enso_effect_per_degC":0.1647,"enso_p":0.0003,"confidence":"Strong","shift_this_season":0.4166,"lines_cross":false},"p50":{"trend_per_decade":0.1498,"trend_p":0.0,"enso_effect_per_degC":0.1849,"enso_p":0.0,"confidence":"Strong","shift_this_season":0.4679,"lines_cross":false},"p95":{"trend_per_decade":0.1581,"trend_p":0.0,"enso_effect_per_degC":0.1072,"enso_p":0.0825,"confidence":"Suggestive","shift_this_season":0.2712,"lines_cross":false},"tails":{"enso_difference":-0.0575,"enso_difference_p":0.3706,"trend_difference":-0.0077,"trend_difference_p":0.8016}},"values":[25.499,25.634,25.491,25.655,25.257,25.489,24.946,25.748,25.868,24.885,26.095,25.81,25.452,25.219,25.792,25.427,25.375,24.89,25.476,25.328,25.676,25.699,26.263,25.425,25.372,25.23,25.56,25.361,25.585,25.316,25.114,25.499,26.093,25.822,25.692,25.701