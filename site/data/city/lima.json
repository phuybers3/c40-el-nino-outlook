g. Without El Niño, a Mar–May this warm would come about once every 9 years. El Niño moves the hottest days most: this season they are expected to shift by about 1.6 °C, against 0.4 °C for the coldest days. Mar–May rainfall has risen by about 5% per decade, with no clear El Niño link. Humidity shows no clear trend or El Niño link. For Mar–May 2027, a warmer-than-normal season is likely (about 90% chance), about 1.3 °C above the 1991–2020 average. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":20.5411,"trend_per_decade":0.1359,"trend_p":0.0021,"trend_total_since_1951":1.0193,"enso_effect_per_degC":0.385,"enso_p":0.0002,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.1719,"intrinsic_sd":0.7919,"effect_this_season":0.9741,"effect_ratio":1.23,"size":"Dominant","size_typical_el_nino":"Substantial","once_every_n_years_without_el_nino":9,"expected_anomaly_2027":1.2524,"forecast_mean":21.7935,"forecast_sd":0.8632,"p_below":0.0244,"p_near":0.0958,"p_above":0.8799,"forecast_words":"Likely (88%): a warmer-than-normal season","within_record":false,"trend_part_2027":0.2783,"roni_upper_within_record":false,"years_of_warming_equivalent":71.6741,"percentiles":{"p05":{"trend_per_decade":0.0937,"trend_p":0.0446,"enso_effect_per_degC":0.1391,"enso_p":0.089,"confidence":"Suggestive","shift_this_season":0.352,"lines_cross":false},"p50":{"trend_per_decade":0.1159,"trend_p":0.012,"enso_effect_per_degC":0.4239,"enso_p":0.0013,"confidence":"Strong","shift_this_season":1.0725,"lines_cross":false},"p95":{"trend_per_decade":0.2865,"trend_p":0.0,"enso_effect_per_degC":0.65,"enso_p":0.0003,"confidence":"Strong","shift_this_season":1.6445,"lines_cross":false},"tails":{"enso_difference":0