 not (about 55%), about 0.4 °C above the 1991–2020 average, mostly because of the long-term warming trend rather than El Niño. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":13.7858,"trend_per_decade":0.2559,"trend_p":0.0,"trend_total_since_1951":1.9192,"enso_effect_per_degC":-0.0291,"enso_p":0.7249,"confidence":"No identifiable effect","survives_fdr":false,"fraction_explained":0.0017,"intrinsic_sd":0.6542,"effect_this_season":-0.0566,"effect_ratio":0.0865,"size":"Negligible","size_typical_el_nino":"Negligible","once_every_n_years_without_el_nino":null,"expected_anomaly_2027":0.4025,"forecast_mean":14.1883,"forecast_sd":0.7004,"p_below":0.1686,"p_near":0.2738,"p_above":0.5575,"forecast_words":"More likely than not (56%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":-0.0224,"shrink_factor":0.7692,"effect_this_season_raw":-0.0735,"trend_part_2027":0.4591,"roni_upper_within_record":false,"years_of_warming_equivalent":-2.2101,"percentiles":{"p05":{"trend_per_decade":0.2875,"trend_p":0.0,"enso_effect_per_degC":-0.012,"enso_p":0.9423,"confidence":"No identifiable effect","shift_this_season":-0.0302,"lines_cross":false},"p50":{"trend_per_decade":0.2316,"trend_p":0.0,"enso_effect_per_degC":0.0217,"enso_p":0.7622,"confidence":"No identifiable effect","shift_this_season":0.0548,"lines_cross":false},"p95":{"trend_per_decade":0.3111,"trend_p":0.0,"enso_effect_per_degC":-0.1261,"enso_p":0.3232,"confidence":"No identifiable effect","shift_this_season":-0.3189,"lines_cross":false},"tails":{"enso_difference":-0.1141,"enso_difference_p":0.5953,"trend_difference":0.0237,"trend_difference_p":0.7498}},"values":[11.885,13.763,13.165,12.304,12.87,12.433,12.849