warmer-than-normal season is likely (about 85% chance), about 1.2 °C above the 1991–2020 average; a wetter-than-normal season is likely (about 80% chance). The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":11.3111,"trend_per_decade":0.2855,"trend_p":0.0,"trend_total_since_1951":2.1413,"enso_effect_per_degC":0.2835,"enso_p":0.0097,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.0892,"intrinsic_sd":0.8489,"effect_this_season":0.7172,"effect_ratio":0.8449,"size":"Substantial","size_typical_el_nino":"Substantial","once_every_n_years_without_el_nino":5,"expected_anomaly_2027":1.2442,"forecast_mean":12.5552,"forecast_sd":0.9222,"p_below":0.0368,"p_near":0.116,"p_above":0.8473,"forecast_words":"Likely (85%): a warmer-than-normal season","within_record":false,"trend_part_2027":0.5269,"roni_upper_within_record":false,"years_of_warming_equivalent":25.1203,"percentiles":{"p05":{"trend_per_decade":0.3157,"trend_p":0.0,"enso_effect_per_degC":0.2314,"enso_p":0.016,"confidence":"Clear","shift_this_season":0.5855,"lines_cross":false},"p50":{"trend_per_decade":0.2742,"trend_p":0.0,"enso_effect_per_degC":0.2654,"enso_p":0.0294,"confidence":"Clear","shift_this_season":0.6715,"lines_cross":false},"p95":{"trend_per_decade":0.2444,"trend_p":0.001,"enso_effect_per_degC":0.4316,"enso_p":0.0166,"confidence":"Clear","shift_this_season":1.0919,"lines_cross":false},"tails":{"enso_difference":0.2001,"enso_difference_p":0.245,"trend_difference":-0.0714,"trend_difference_p":0.3746}},"values":[9.211,10.987,9.963,11.353,9.363,9.742,9.617,10.416,10.555,11.721,9.544,9.951,8.97,10.343,10.617,10.507,9.31,8.082,11.821,9.761,9.939,10.432,11.306,8.945,11.334,9.426,9.294,11.211,11.91,10.675,10.436,10