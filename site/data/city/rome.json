 air is drier. For Mar–May 2027, a warmer-than-normal season is slightly favored (about 45%), about 0.4 °C above the 1991–2020 average, mostly because of the long-term warming trend rather than El Niño. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":14.0865,"trend_per_decade":0.2513,"trend_p":0.0,"trend_total_since_1951":1.8845,"enso_effect_per_degC":-0.0458,"enso_p":0.6254,"confidence":"No identifiable effect","survives_fdr":false,"fraction_explained":0.0033,"intrinsic_sd":0.7425,"effect_this_season":-0.0835,"effect_ratio":0.1125,"size":"Negligible","size_typical_el_nino":"Negligible","once_every_n_years_without_el_nino":null,"expected_anomaly_2027":0.4048,"forecast_mean":14.4913,"forecast_sd":0.7931,"p_below":0.2058,"p_near":0.3545,"p_above":0.4396,"forecast_words":"Slightly favored (44%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":-0.033,"shrink_factor":0.7212,"effect_this_season_raw":-0.1158,"trend_part_2027":0.4883,"roni_upper_within_record":false,"years_of_warming_equivalent":-3.3245,"percentiles":{"p05":{"trend_per_decade":0.2576,"trend_p":0.023,"enso_effect_per_degC":-0.097,"enso_p":0.6231,"confidence":"No identifiable effect","shift_this_season":-0.2454,"lines_cross":false},"p50":{"trend_per_decade":0.2566,"trend_p":0.0,"enso_effect_per_degC":-0.0545,"enso_p":0.6545,"confidence":"No identifiable effect","shift_this_season":-0.1378,"lines_cross":false},"p95":{"trend_per_decade":0.3015,"trend_p":0.0,"enso_effect_per_degC":-0.0961,"enso_p":0.5394,"confidence":"No identifiable effect","shift_this_season":-0.2431,"lines_cross":false},"tails":{"enso_difference":0.0009,"enso_difference_p":0.9975,"trend_difference":0.0439,"trend_differ