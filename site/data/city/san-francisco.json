ong-term warming trend rather than El Niño; a wetter-than-normal season is more likely than not (about 60%). The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":10.1561,"trend_per_decade":0.2277,"trend_p":0.0,"trend_total_since_1951":1.7078,"enso_effect_per_degC":0.1873,"enso_p":0.0725,"confidence":"Suggestive","survives_fdr":false,"fraction_explained":0.0441,"intrinsic_sd":0.8172,"effect_this_season":0.3125,"effect_ratio":0.3824,"size":"Noticeable","size_typical_el_nino":"Negligible","once_every_n_years_without_el_nino":null,"expected_anomaly_2027":0.7775,"forecast_mean":10.9336,"forecast_sd":0.8707,"p_below":0.0817,"p_near":0.2161,"p_above":0.7022,"forecast_words":"Likely (70%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":0.1235,"shrink_factor":0.6593,"effect_this_season_raw":0.4739,"trend_part_2027":0.4651,"roni_upper_within_record":false,"years_of_warming_equivalent":13.7231,"percentiles":{"p05":{"trend_per_decade":0.323,"trend_p":0.0,"enso_effect_per_degC":0.0362,"enso_p":0.7807,"confidence":"No identifiable effect","shift_this_season":0.0915,"lines_cross":false},"p50":{"trend_per_decade":0.2184,"trend_p":0.0,"enso_effect_per_degC":0.2397,"enso_p":0.0308,"confidence":"Clear","shift_this_season":0.6064,"lines_cross":false},"p95":{"trend_per_decade":0.1553,"trend_p":0.0118,"enso_effect_per_degC":0.0453,"enso_p":0.7452,"confidence":"No identifiable effect","shift_this_season":0.1145,"lines_cross":false},"tails":{"enso_difference":0.0091,"enso_difference_p":0.9608,"trend_difference":-0.1678,"trend_difference_p":0.0697}},"values":[9.954,8.654,10.031,9.607,7.949,9.386,8.675,10.286,10.938,9.626,9.062,8.248,9.61,8.345,9.732,7.855,9.243,9.091,8.4