kely (about 75% chance). The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":23.0716,"trend_per_decade":0.1147,"trend_p":0.0035,"trend_total_since_1951":0.8605,"enso_effect_per_degC":-0.2067,"enso_p":0.0227,"confidence":"Clear","survives_fdr":false,"fraction_explained":0.07,"intrinsic_sd":0.7062,"effect_this_season":-0.3773,"effect_ratio":0.5343,"size":"Substantial","size_typical_el_nino":"Noticeable","once_every_n_years_without_el_nino":3,"expected_anomaly_2027":0.0243,"forecast_mean":23.0959,"forecast_sd":0.7553,"p_below":0.2842,"p_near":0.4041,"p_above":0.3116,"forecast_words":"Slightly favored (40%): a near-normal season","within_record":false,"enso_effect_shrunk_per_degC":-0.1491,"shrink_factor":0.7216,"effect_this_season_raw":-0.523,"trend_part_2027":0.4016,"roni_upper_within_record":false,"years_of_warming_equivalent":-32.8893,"percentiles":{"p05":{"trend_per_decade":0.0108,"trend_p":0.849,"enso_effect_per_degC":-0.179,"enso_p":0.2077,"confidence":"No identifiable effect","shift_this_season":-0.4529,"lines_cross":false},"p50":{"trend_per_decade":0.1124,"trend_p":0.0165,"enso_effect_per_degC":-0.1905,"enso_p":0.1216,"confidence":"No identifiable effect","shift_this_season":-0.482,"lines_cross":false},"p95":{"trend_per_decade":0.1795,"trend_p":0.0001,"enso_effect_per_degC":-0.293,"enso_p":0.0274,"confidence":"Clear","shift_this_season":-0.7413,"lines_cross":false},"tails":{"enso_difference":-0.114,"enso_difference_p":0.3723,"trend_difference":0.1687,"trend_difference_p":0.0001}},"values":[23.256,22.675,23.419,23.577,23.785,24.259,23.283,22.023,22.559,23.508,22.373,21.746,22.959,22.154,23.246,21.777,22.331,23.271,22.709,23.578,21.898,23.515,22.417,22.112,22.19,22.996,22.385,