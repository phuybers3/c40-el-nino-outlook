in Tel Aviv-Yafo has warmed by about 0.2 °C per decade since 1951, roughly 1.6 °C in all. El Niño has no identifiable effect on Mar–May temperature. Mar–May rainfall has fallen by about 5% per decade, with no clear El Niño link. Relative humidity has fallen by about 0.3 points per decade, roughly 3 points since 1951; because warmer air holds more moisture, this does not necessarily mean the air is drier. For Mar–May 2027, a warmer-than-normal season is more likely than not (about 60%), about 0.4 °C above the 1991–2020 average, mostly because of the long-term warming trend rather than El Niño. The El Niño expected for Sep–Nov 2026 is stronger than any in the record used here, so the outlook extends the historical relationship beyond what has been observed. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":18.816,"trend_per_decade":0.2153,"trend_p":0.0,"trend_total_since_1951":1.615,"enso_effect_per_degC":-0.071,"enso_p":0.4018,"confidence":"No identifiable effect","survives_fdr":false,"fraction_explained":0.0098,"intrinsic_sd":0.6692,"effect_this_season":-0.1367,"effect_ratio":0.2042,"size":"Negligible","size_typical_el_nino":"Negligible","once_every_n_years_without_el_nino":null,"expected_anomaly_2027":0.3538,"forecast_mean":19.1698,"forecast_sd":0.7163,"p_below":0.1885,"p_near":0.2048,"p_above":0.6067,"forecast_words":"More likely than not (61%): a warmer-than-normal season","within_record":false,"enso_effect_shrunk_per_degC":-0.054,"shrink_factor":0.761,"effect_this_season_raw":-0.1796,"trend_part_2027":0.4905,"roni_upper_within_record":false,"years_of_warming_equivalent":-6.3463,"percentiles":{"p05":{"trend_per_decade":0.1684,"trend_p":0.071,"enso_effect_per_degC":-0.1185,"enso_p":0.495,"confidence":"No identifiable effect","shift_this_season":-0.2998,"lines_cross":false},"p50":{"trend_per_decade":0.2116,"trend_p":0.0,"enso_effect_per_d