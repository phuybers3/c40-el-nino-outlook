1; because warmer air holds more moisture, this does not necessarily mean the air is drier. El Niño has a modest but consistent effect toward a more humid Mar–May, and this year's shift is substantial. For Mar–May 2027, a warmer-than-normal season is very likely (more than 95% chance), about 0.9 °C above the 1991–2020 average. This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":19.7616,"trend_per_decade":0.2803,"trend_p":0.0,"trend_total_since_1951":2.1019,"enso_effect_per_degC":0.147,"enso_p":0.0124,"confidence":"Clear","survives_fdr":false,"fraction_explained":0.0837,"intrinsic_sd":0.4561,"effect_this_season":0.3235,"effect_ratio":0.7092,"size":"Substantial","size_typical_el_nino":"Noticeable","once_every_n_years_without_el_nino":4.0,"expected_anomaly_2027":0.9406,"p_below":0.0061,"p_near":0.0346,"p_above":0.9593,"forecast_words":"Very likely (>95%): a warmer-than-normal season","within_record":true,"years_of_warming_equivalent":11.5419,"values":[17.762,18.431,17.813,18.136,18.122,18.305,18.613,18.875,19.204,18.767,19.826,18.084,18.278,18.714,18.733,18.753,19.104,17.874,18.612,18.644,18.657,19.046,19.881,18.522,19.441,19.295,18.838,18.125,18.415,19.488,18.858,19.406,19.928,19.732,18.734,19.04,20.011,19.251,18.643,18.787,19.468,19.477,19.37,19.619,19.276,19.43,19.502,19.818,19.276,19.86,19.139,19.338,19.951,19.661,19.999,19.408,19.843,19.291,20.568,19.794,20.453,19.93,19.529,19.719,20.019,20.402,20.717,18.953,21.35,19.686,20.094,20.671,19.855,20.563,20.131],"forecast_mean":20.7023,"forecast_sd":0.4897,"fit":{"a2027":20.3788,"b":0.147,"c":0.028,"tercile_low":19.4743,"tercile_high":19.8487},"percentiles":{"p05":{"trend_per_decade":0.2321,"trend_p":0.0,"enso_effect_per_degC":0.1185,"enso_p":0.0155,"confidence":"Clear","shift_this_season":0.2607,"lines_cross":false},"p50":{"trend_per_decade":0.2746,"trend_p":0.0,"enso_effect_per_degC":0.1604,"e