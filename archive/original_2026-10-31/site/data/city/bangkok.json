mber.","variables":{"temperature":{"normal_1991_2020":30.2816,"trend_per_decade":0.2123,"trend_p":0.0,"trend_total_since_1951":1.5925,"enso_effect_per_degC":0.3621,"enso_p":0.0,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.3482,"intrinsic_sd":0.4642,"effect_this_season":0.7965,"effect_ratio":1.7158,"size":"Dominant","size_typical_el_nino":"Dominant","once_every_n_years_without_el_nino":23.0,"expected_anomaly_2027":1.2023,"p_below":0.0026,"p_near":0.0332,"p_above":0.9641,"forecast_words":"Very likely (>95%): a warmer-than-normal season","within_record":true,"years_of_warming_equivalent":37.5133,"values":[29.642,28.856,27.682,29.209,28.991,28.909,29.689,30.088,29.357,30.062,29.046,29.405,29.686,29.163,29.0,29.271,29.129,28.914,30.209,29.432,28.902,29.324,30.05,28.625,29.386,28.948,29.333,29.944,30.502,30.827,29.67,29.778,30.445,29.627,29.65,29.34,30.206,29.944,30.292,30.47,30.396,31.078,30.361,30.086,30.564,29.793,30.28,31.134,29.509,29.813,29.771,30.215,30.594,30.517,30.672,30.33,29.993,29.587,29.611,31.086,28.809,30.633,30.702,30.478,30.44,31.05,30.049,29.268,30.871,30.758,29.815,29.551,30.594,31.177,30.035],"forecast_mean":31.4839,"forecast_sd":0.5053,"fit":{"a2027":30.6874,"b":0.3621,"c":0.0212,"tercile_low":30.0734,"tercile_high":30.574},"percentiles":{"p05":{"trend_per_decade":0.218,"trend_p":0.0,"enso_effect_per_degC":0.3172,"enso_p":0.0072,"confidence":"Strong","shift_this_season":0.6978,"lines_cross":false},"p50":{"trend_per_decade":0.2172,"trend_p":0.0,"enso_effect_per_degC":0.3836,"enso_p":0.0,"confidence":"Strong","shift_this_season":0.8439,"lines_cross":false},"p95":{"trend_per_decade":0.1769,"trend_p":0.0,"enso_effect_per_degC":0.2516,"enso_p":0.0006,"confidence":"Strong","shift_this_season":0.5534,"lines_cross":false},"tails":{"enso_difference":-0.0656,"enso_difference_p":0.6429,"trend_difference":-0.041,"trend_difference_p":0.3732}},"yearly":{"p05":[28.188,26.682,25.932,26.794,27.424,27.585,26.619,28.786,27.008,27.546,27.022,27.777,2