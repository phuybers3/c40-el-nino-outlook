1953,1954,1955,1956,1957,1958,1959,1960,1961,1962,1963,1964,1965,1966,1967,1968,1969,1970,1971,1972,1973,1974,1975,1976,1977,1978,1979,1980,1981,1982,1983,1984,1985,1986,1987,1988,1989,1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025],"roni_lead":[-0.38,0.98,0.04,0.84,-0.31,-1.31,-0.14,1.16,0.24,0.04,0.08,-0.16,-0.3,1.06,-0.64,1.86,-0.03,-0.08,0.56,0.67,-0.57,-0.4,1.82,-1.63,-0.45,-0.95,1.04,0.89,-0.08,0.52,-0.06,-0.17,2.03,-0.9,-0.61,-0.18,1.0,1.2,-1.71,-0.23,0.27,1.2,0.1,0.46,0.97,-0.93,-0.25,2.22,-1.33,-1.06,-0.55,-0.18,1.18,0.17,0.7,-0.18,0.73,-1.33,-0.38,0.86,-1.61,-0.91,0.21,-0.22,0.35,2.03,-0.96,-0.82,0.62,0.15,-1.37,-1.08,-1.1,1.3,-0.76],"paragraph":"Mar–May in Seattle has warmed by about 0.25 °C per decade since 1951, roughly 1.9 °C in all. There is a strong, well-established El Niño effect on temperature: after El Niño conditions in the preceding fall, Mar–May tends to run warmer, and El Niño accounts for about 20% of the year-to-year ups and downs. With this year's strong El Niño, that push is about as large as a normal year-to-year swing, roughly as much warmth as 36 years of the long-term trend. Without El Niño, a Mar–May this warm would come about once every 9 years. Mar–May rainfall shows no clear long-term trend, but El Niño has a modest but consistent effect toward a drier season with fewer rainy days, and this year's shift is substantial. Relative humidity has fallen by about 0.2 points per decade, roughly 2 points since 1951; because warmer air holds more moisture, this does not necessarily mean the air is drier. For Mar–May 2027, a warmer-than-normal season is likely (about 85% chance), about 1.4 °C above the 1991–2020 average; a drier-than-normal season is more likely than not (about 55%). This outlook is based on the El Niño strength expected for Sep–Nov 2026 and will be updated when it is observed in early December.","variables":{"temperature":{"normal_1991_2020":10.3898,"trend_per_decade":0.2469,"trend_p":0.0,"trend_total_since_1951":1.8521,"enso_effect_per_degC":0.404,"enso_p":0.0,"confidence":"Strong","survives_fdr":true,"fraction_explained":0.2076,"intrinsic_sd":0.7397,"effect_this_season":0.8888,"effect_ratio":1.2016,"size":"Dominant","size_typical_el_nino":"Substantial","once_every_n_years_without_el_nino":9.0,"expected_anomaly_2027":1.373,"p_below":0.0163,"p_near":0.1217,"p_above":0.862,"forecast_words":"Likely (86%): a warmer-than-normal season","within_record":true,"years_of_warming_equivalent":35.9897,"values":[8.94,9.307,9.106,8.496,7.04,9.701,10.283,10.631,9.319,9.001,9.349,8.748,9.381,8.136,9.164,9.634,8.702,9.864,10.295,9.234,8.866,9.81,9.813,9.232,8.611,8.851,9.65,10.065,10.481,10.004,10.312,9.306,11.12,9.728,9.538,10.261,11.177,9.981,10.116,10.602,9.492,12.003,11.158,11.227,10.865,10.08,10.476,10.291,8.896,10.009,9.728,8.773,10.116,11.417,11.406,10.206,10.455,8.755,9.246,9.686,8.708,9.692,10.623,11.299,11.708,12.332,10.546,10.95,11.136,10.418,10.263,9.406,10.378,10.207,10.828],"forecast_mean":11.7629,"forecast_sd":0.7984,"fit":{"a2027":10.8741,"b":0.404,"c":0.0247,"tercile_low":10.0563,"tercile_high":10.893},"percentiles":{"p05":{"trend_per_decade":0.3177,"trend_p":0.0,"enso_effect_per_degC":0.5181,"enso_p":0.0,"confidence":"Strong","shift_this_season":1.1399,"lines_cross":false},"p50":{"trend_per_decade":0.247,"trend_p":0.0,"enso_effect_per_degC":0.348,"enso_p":0.0015,"confidence":"Strong","shift_this_season":0.7655,"lines_cross":false},"p95":{"trend_per_decade":0.1726,"trend_p":0.048,"enso_effect_per_degC":0.5355,"enso_p":0.0195,"confidence":"Clear","shift_this_season":1.1781,"lines_cross":false},"tails":{"enso_difference":0.0174,"enso_difference_p":0.9443,"trend_difference":-0.1451,"trend_difference_p":0.1597}},"yearly":{"p05":[0.483,4.325,4.643,3.456,2.182,2.136,5.15,4.976,5.333,3.386,4.512,3.578,4.943,3.952,3.678,3.771,4.24,5.277,4.962,5.281,2.826,4.168,6